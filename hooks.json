{
  "makefile-workflow-guard": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./scripts/session_start.py"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/pre_tool_guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
