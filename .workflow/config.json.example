{
  "$comment": "Makefile Workflow User Configuration Template. Subagent tiers are specific to Google Antigravity (agy). Valid tiers are inherit, flash_lite, flash, and pro. When set to inherit, subagents inherit the active model and session reasoning effort (/effort). Other platforms ignore this section.",
  "models": {
    "adversarial-critic": "inherit",
    "archaeology-worker": "inherit",
    "tdd-worker": "inherit",
    "triage-worker": "inherit"
  },
  "review": {
    "maxReviewRounds": 3,
    "strictSixPillars": true
  },
  "ci": {
    "pollIntervalSeconds": 30,
    "quiescenceSeconds": 180
  },
  "database": {
    "prodDatabases": [],
    "testDatabases": [],
    "prodHosts": []
  }
}
